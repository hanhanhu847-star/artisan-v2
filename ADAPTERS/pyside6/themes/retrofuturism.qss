/* 复古未来主义；用于 QApplication.setStyleSheet，由 Qt 处理键盘与状态。 */
QWidget {background:#292541;color:#F7DDBB;font-size:14px;}
QPushButton,QLineEdit,QComboBox,QListWidget,QTableView {border:1px solid #F7DDBB;border-radius:22px;padding:6px;}
QPushButton {background:#F38B69;color:#161819;min-height:28px;}
QPushButton:hover,QLineEdit:focus {border:2px solid #80BCC1;}
QPushButton:checked,QListView::item:selected {background:#F7DDBB;color:#292541;}
QPushButton:disabled {background:#292541;color:#F7DDBB;border:1px dashed #80BCC1;}
QLineEdit[invalid="true"] {border:2px solid #ffb6aa;}
QProgressBar {border:1px solid #F7DDBB;text-align:center;} QProgressBar::chunk {background:#80BCC1;}