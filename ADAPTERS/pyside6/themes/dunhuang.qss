/* 敦煌艺术；用于 QApplication.setStyleSheet，由 Qt 处理键盘与状态。 */
QWidget {background:#EBD3AC;color:#593E32;font-size:14px;}
QPushButton,QLineEdit,QComboBox,QListWidget,QTableView {border:1px solid #593E32;border-radius:4px;padding:6px;}
QPushButton {background:#9B4D39;color:#FFF9EE;min-height:28px;}
QPushButton:hover,QLineEdit:focus {border:2px solid #45867F;}
QPushButton:checked,QListView::item:selected {background:#593E32;color:#EBD3AC;}
QPushButton:disabled {background:#EBD3AC;color:#593E32;border:1px dashed #45867F;}
QLineEdit[invalid="true"] {border:2px solid #8d2c27;}
QProgressBar {border:1px solid #593E32;text-align:center;} QProgressBar::chunk {background:#45867F;}